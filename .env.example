# Public project URL and publishable (or legacy anon) key. NEVER use service_role.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Repository path, including trailing slash; use / for root hosting.
VITE_BASE_PATH=/reading-queue/
# Edge Function secret (not VITE): comma-separated allowed frontend origins.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://USERNAME.github.io
